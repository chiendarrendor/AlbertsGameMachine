
<define name="BuyMen">
  <panel>
    <image image="iIMAGEi" x="5"/>
    <minmaxvarselection varname="iOUTVARi" min="1" max="iINVARi" x="50"/>
    <text x="100">
	    <replace from="rCOSTr" eventvar="myPurchaseInfo.manCost" initial="0"/>
	    @ rCOSTr each.
    </text>
  </panel>
</define>



<define name="BuyThing">
  <panel>
    <image image="iIMAGEi" x="5"/>
    <minmaxvarselection varname="iOUTVARi" min="1" max="iINVARi" x="50"/>
    <text x="100">@ iCOSTi each.</text>
  </panel>
</define>
  



<actions>
  <!-- OPTIONS/JOIN/STANDARDBASIC/STANDARDEXPERT/UNJOIN/VALIDATESETUP/DONTLIKEOPTIONS/
       LIKEOPTIONS are now fired from OptionPanel.java's own "go" buttons
       (Players.xml), not an ActionNode button here; onstate="statedalwayshidden"
       keeps each ActionNode's legality tracking/ActionGo() submission alive
       (OptionPanel subscribes via ActionTransferManager.AddButtonPresser/
       ButtonPressed) while never rendering its own panel. See .claude/TODO.md's
       "Migrate Outpost's client GUI away from ActionNode/ActionTabNode-driven
       buttons" entry. -->
  <action name="OPTIONS" text="Apply Option Changes" onstate="statedalwayshidden">
    <var name="Discard"       paramname="discard" paramtype="bool" hidden="y" noreset="y" text="Discard Before Buy"/>
    <var name="Refinery"      paramname="refinery" paramtype="bool" hidden="y" noreset="y" text="Refinery"/>
    <var name="OneUpgrade"    paramname="oneupgrade" paramtype="bool" hidden="y" noreset="y" text="One Upgrade Purchase Per Player Per Turn"/>
    <var name="ActiveBid"     paramname="activebid" paramtype="bool" hidden="y" noreset="y" text="Only Active Players May Bid"/>
    <var name="SupplyShipFilling" paramname="supplyharshness" paramtype="int" hidden="y" noreset="y" text="Ship Supply Loading Mechanism"/>
    <var name="Robots"        paramname="robots" paramtype="int" hidden="y" noreset="y" text="Robot Mechanism"/>
    <var name="ResearchMega"  paramname="researchmega" paramtype="bool" hidden="y" noreset="y" text="Research has Mega"/>
    <var name="SmallResearch" paramname="smallresearch" paramtype="bool" hidden="y" noreset="y" text="Research resources are zero size"/>
    <var name="SmallMicro"    paramname="smallmicro" paramtype="bool" hidden="y" noreset="y" text="Microbiotics resources are zero size"/>
    <var name="BlindDraws"    paramname="blinddraws" paramtype="bool" hidden="y" noreset="y" text="Draws only visible at end of draw phase"/>
    <var name="Stocking"      paramname="stock" paramtype="int" hidden="y" noreset="y" text="Initial Item Stocking Mechanism"/>
  </action>
  <action name="JOIN" text="Join Game" onstate="statedalwayshidden"/>
  <action name="STANDARDBASIC" text="Select Basic Game Options" onstate="statedalwayshidden"/>
  <action name="STANDARDEXPERT" text="Select Expert Game Options" onstate="statedalwayshidden"/>
  <action name="UNJOIN" text="Leave Game" onstate="statedalwayshidden"/>
  <action name="VALIDATESETUP" text="Start Game" onstate="statedalwayshidden"/>
  <action name="DONTLIKEOPTIONS" text="I don't like the Selected Options" onstate="statedalwayshidden"/>
  <action name="LIKEOPTIONS" text="I like the Selected Options" onstate="statedalwayshidden"/>
  <action name="WATERMULLIGAN" text="Mulligan Water Factory" alerts="true"/>

  <action name="BUYMEN" text="Buy Men" alerts="true">
    <var name="NumMen" paramname="i_nummen" paramtype="int" text="Number of Men to Buy" noreset="y">
      <named name="BuyMen" iOUTVARi="NumMen" iINVARi="myPurchaseInfo.numMen" iIMAGEi="Man.PNG"/>
    </var>
    <var name="DiscardString" paramname="i_discardstring" hidden="y" noreset="y" text="Discard String"/>
  </action>

  <action name="BUYROBOTS" text="Buy Robots" alerts="true">
    <var name="NumRobots" paramname="i_numrobots" paramtype="int" text="Number of Robots to Buy" noreset="y">
      <named name="BuyThing" iOUTVARi="NumRobots" iINVARi="myPurchaseInfo.numRobots" iCOSTi="10" iIMAGEi="Robot.PNG"/>
    </var>
    <var name="DiscardString" paramname="i_discardstring" hidden="y" noreset="y" text="Discard String"/>
  </action>

  <action name="BUYOREFACTORIES" text="Buy Ore Factories" alerts="true">
    <var name="NumOre" paramname="i_numfactories" paramtype="int" text="Number of Ore Factories to Buy" noreset="y">
      <named name="BuyThing" iOUTVARi="NumOre" iINVARi="myPurchaseInfo.numOre" iCOSTi="10" iIMAGEi="Ore.PNG"/>
    </var>
    <var name="DiscardString" paramname="i_discardstring" hidden="y" noreset="y" text="Discard String"/>
  </action>

  <action name="BUYWATERFACTORIES" text="Buy Water Factories" alerts="true">
    <var name="NumWater" paramname="i_numfactories" paramtype="int" text="Number of Water Factories to Buy" noreset="y">
      <named name="BuyThing" iOUTVARi="NumWater" iINVARi="myPurchaseInfo.numWater" iCOSTi="20" iIMAGEi="Water.PNG"/>
    </var>
    <var name="DiscardString" paramname="i_discardstring" hidden="y" noreset="y" text="Discard String"/>
  </action>

  <action name="BUYTITANIUMFACTORIES" text="Buy Titanium Factories" alerts="true">
    <var name="NumTite" paramname="i_numfactories" paramtype="int" text="Number of Titanium Factories to Buy" noreset="y">
      <named name="BuyThing" iOUTVARi="NumTite" iINVARi="myPurchaseInfo.numTitanium" iCOSTi="30" iIMAGEi="Titanium.PNG"/>
    </var>
    <var name="DiscardString" paramname="i_discardstring" hidden="y" noreset="y" text="Discard String"/>
  </action>

  <action name="BUYRESEARCHFACTORIES" text="Buy Research Centers" alerts="true">
    <var name="NumResearch" paramname="i_numfactories" paramtype="int" text="Number of Research Factories to Buy" noreset="y">
      <named name="BuyThing" iOUTVARi="NumResearch" iINVARi="myPurchaseInfo.numResearch" iCOSTi="40" iIMAGEi="Research.PNG"/>
    </var>
    <var name="DiscardString" paramname="i_discardstring" hidden="y" noreset="y" text="Discard String"/>
  </action>

  <action name="BUYNEWCHEMFACTORIES" text="Buy New Chemical Factories" alerts="true">
    <var name="NumNewChem" paramname="i_numfactories" paramtype="int" text="Number of NewChem Factories to Buy" noreset="y">
      <named name="BuyThing" iOUTVARi="NumNewChem" iINVARi="myPurchaseInfo.numNewChem" 
             iCOSTi="60, incl. 1 Research," iIMAGEi="NewChemicals.PNG"/>
    </var>
    <var name="DiscardString" paramname="i_discardstring" hidden="y" noreset="y" text="Discard String"/>
  </action>

  <action name="OPENBID" text="Open Bidding" alerts="true">
    <var name="ShipSlot" paramname="i_shipslot" paramtype="int" text="Which Supply Ship Slot to bid on" noreset="y"/>
    <var name="OpeningBid" paramname="i_openingbid" paramtype="int" text="Opening Bid" noreset="y">
      <panel layout="hbox">
        <text>Opening Bid:</text>
	<javaclass classname="StateSensitiveTextBox" varname="OpeningBid"/>
	<javaclass classname="BidItemWatcher" ConsumeVariable="true"/>
      </panel>
    </var>
  </action>

  <action name="BID" text="Raise Bid" alerts="true">
    <var name="Bid" paramname="i_bid" paramtype="int" text="New Bid" noreset="y">
      <panel layout="hbox">
        <text>Raise Bid To:</text>
	<javaclass classname="StateSensitiveTextBox" varname="Bid"/>
	<javaclass classname="BidItemWatcher"/>
      </panel>
    </var>
  </action>

  <action name="PASS" text="Pass" alerts="true"/>
  <action name="PASSOUT" text="Pass Out"/>

  <action name="NUMMEGAS" text="Select # of Megas" alerts="true">
    <var name="MegaCount" paramname="i_count" paramtype="int" text="Number of Megas to Draw" noreset="y">
      <panel>
        <javaclass classname="CommodityMegaSelector"/>
        <minmaxvarselection varname="MegaCount" min="0" max="megaRequest.maxMegas" x="90" y="30"/>
      </panel>
    </var>
  </action>

  <action name="DISCARD" text="Discard to Hand Limit" alerts="true">
    <var name="DiscardString" paramname="i_discardstring" hidden="y" noreset="y" text="Discard String"/>
  </action>

  <action name="PURCHASEBID" text="Purchase Item" alerts="true">
    <var name="DiscardString" paramname="i_discardstring" noreset="y" text="Discard String">
      <text>
        <replace from="rCOSTr" eventvar="bidInfo.price" initial="0"/>
	  Winning Bid will cost: rCOSTr
      </text>
    </var>
  </action>

  <action name="ALTERMANNING" text="Apply Manning Changes" onstate="statedalwayshidden">
    <var name="ManString" paramname="i_manningstring" hidden="y" noreset="y" text="Alter Manning String"/>
  </action>

  <action name="INTERNALIZE" text="Internalize"/>
  <action name="DONE" text="End Turn" alerts="true"/>
  <action name="FINALDONE" text="End Turn and Manning" alerts="true"/>
  <action name="DONEMANNING" text="End Manning Phase" alerts="true"/>

</actions>
