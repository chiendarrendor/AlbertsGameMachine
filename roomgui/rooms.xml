<?xml version="1.0" encoding="utf-8" ?>
<gameboard>

<actions>
  <action name="NEWROOM" text="Make New Room">
    <var name="RoomName" text="Name of New Room" hastextbox="y">
    </var>
  </action>
  <action name="CHANGEROOM" onstate="alwayshidden" text="Move To Selected Room">
    <var name="TargetRoom" text="Name of Target Room"/>
  </action>
  <action name="NEWGAME" text="Start New Game">
    <var name="NewGame" text="Name of New Game">
      <varselection varname="NewGame" listpath="myroom.gameTypes[]"/>
    </var>
  </action>
  <action name="LOADGAME" text="Load Game">
    <var name="NameToLoad" text="Name of File to Load">
      <varselection varname="NameToLoad" listpath="myroom.savedGames[]"/>
    </var>
  </action>
  <action name="SAVEGAME" text="Save Game">
    <var name="NameToSave" text="Name of File to Save"  hastextbox="y"/>
  </action>
</actions>

<tab title="Room Info">
  <javaclass classname="RoomPage"/>
</tab>

</gameboard>
